# Copy to .env (never commit .env). Real environment variables win over .env.

# --- engine: MySQL source/target for the CLI and Streamlit tools
NAZEER_MYSQL_HOST=localhost
NAZEER_MYSQL_PORT=3306
NAZEER_MYSQL_USER=root
NAZEER_MYSQL_PASSWORD=CHANGE_ME

# --- web API + worker
# MySQL (utf8mb4) for the app's own tables; SQLite also works for a quick local try.
DATABASE_URL=mysql+pymysql://root:CHANGE_ME@localhost:3306/nazeer_app?charset=utf8mb4
# Only if your MySQL requires TLS with a private CA: the CA certificate (PEM). Empty for Railway/local.
DATABASE_CA_PEM=
# 32 random bytes, base64. Encrypts every organization's key. Generate:
#   python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
NAZEER_MASTER_KEY=
# The web app's origin (links in emails, CORS allow-list). The browser calls /api/* on this origin;
# Next.js rewrites proxy it to the API, so cookies are first-party.
APP_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
# 0 only for plain-http local development; production must keep 1 (Secure, __Host- cookies).
COOKIE_SECURE=0
# Leave empty: host-only cookies on the web origin.
COOKIE_DOMAIN=
# 1 when the API runs behind a proxy that sets X-Forwarded-For (the hosted backend).
TRUST_PROXY=0

# Hosted limits (defaults sized for 0.5 GB per service; see docs/DEPLOY.md)
NAZEER_MAX_ROWS_MASKED=100000
NAZEER_MAX_ROWS_SYNTHETIC=15000
NAZEER_ORG_QUOTA_MB=100
NAZEER_SESSION_MINUTES=30
NAZEER_TWIN_RETENTION_DAYS=14
# Production: api | worker | all (python -m nazeer_api.serve)
NAZEER_ROLE=all
